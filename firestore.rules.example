rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly(['category','message','game','source','status','createdAt'])
        && request.resource.data.category is string
        && request.resource.data.message is string
        && request.resource.data.game is string
        && request.resource.data.source is string
        && request.resource.data.status == 'unresolved'
        && request.resource.data.createdAt is timestamp;
      allow read: if request.auth != null && request.auth.uid == 'ADMIN_UID';
      allow update, delete: if request.auth != null && request.auth.uid == 'ADMIN_UID';
    }
    match /changelog/main {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null && request.auth.uid == 'ADMIN_UID';
    }
  }
}